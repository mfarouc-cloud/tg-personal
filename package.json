{
  "name": "tg-personal",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "Personal Telegram client (Nicegram/TeleDark-style power features) as an installable PWA",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vite-plugin-pwa": "^0.21.1"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "buffer": "^6.0.3",
    "lottie-web": "^5.13.0",
    "opus-recorder": "^8.0.5",
    "teleproto": "^1.232.0"
  },
  "overrides": {
    "buffer": "^6.0.3"
  }
}
