+
+    // HBOLT 0046: ref-counted override that forces the native (iOS 26 UIGlassEffect) glass while a
+    // media viewer for a group/channel is open, even if the "Fake glass" setting is on. The setting
+    // is read when a glass view is created, so views built while the override is held are native.
+    // Main-thread only (UI construction); begin/end hop to main when called elsewhere.
+    private static var hboltNativeGlassOverrideCount: Int = 0
+
+    public static var hboltUseCustomGlass: Bool {
+        return GlassBackgroundView.useCustomGlassImpl && GlassBackgroundView.hboltNativeGlassOverrideCount == 0
+    }
+
+    public static func hboltBeginNativeGlass() {
+        if Thread.isMainThread {
+            GlassBackgroundView.hboltNativeGlassOverrideCount += 1
+        } else {
+            DispatchQueue.main.async {
+                GlassBackgroundView.hboltNativeGlassOverrideCount += 1
+            }
+        }
+    }
+
+    public static func hboltEndNativeGlass() {
+        let end: () -> Void = {
+            GlassBackgroundView.hboltNativeGlassOverrideCount = max(0, GlassBackgroundView.hboltNativeGlassOverrideCount - 1)
+        }
+        if Thread.isMainThread {
+            end()
+        } else {
+            DispatchQueue.main.async(execute: end)
+        }
+    }
     
