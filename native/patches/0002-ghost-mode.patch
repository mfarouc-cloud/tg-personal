new file mode 100644
index 00000000..15e10fb0
--- /dev/null
+++ b/submodules/TelegramCore/Sources/HBOLTSettings.swift
@@ -0,0 +1,12 @@
+import Foundation
+
+/// HBOLT on-device feature switches (stored only in this app's UserDefaults).
+public enum HBOLTSettings {
+    private static let defaults = UserDefaults.standard
+
+    /// Ghost Mode: never appear online, never send "typing…", never send read receipts.
+    public static var ghostMode: Bool {
+        get { return defaults.bool(forKey: "hbolt.ghostMode") }
+        set { defaults.set(newValue, forKey: "hbolt.ghostMode") }
+    }
+}
