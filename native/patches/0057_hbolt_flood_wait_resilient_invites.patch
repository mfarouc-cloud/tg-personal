+// HBOLT 0057: FLOOD_WAIT-resilient invite checking. Opening many invite links quickly used to hit
+// "too many attempts" and stop the user's work. Now: short floods are auto-waited by MTProto, a
+// bounded retry waits out a reported FLOOD_WAIT and tries again (so the preview still opens, just
+// later), and successful checks are cached briefly so re-opening the same link does not re-hit the
+// server at all. The server-side rate limit itself is NOT bypassed — requests are paced and waited
+// for, never forced.
+private let hboltInviteCheckLock = NSLock()
+private var hboltInviteCheckCache: [String: (invite: Api.ChatInvite, time: Double)] = [:]
+private let hboltInviteCheckTTL: Double = 180.0
+
+private func hboltCachedInvite(_ hash: String) -> Api.ChatInvite? {
+    hboltInviteCheckLock.lock()
+    defer { hboltInviteCheckLock.unlock() }
+    if let entry = hboltInviteCheckCache[hash], CFAbsoluteTimeGetCurrent() - entry.time < hboltInviteCheckTTL {
+        return entry.invite
+    }
+    return nil
+}
+
+private func hboltStoreInvite(_ hash: String, _ invite: Api.ChatInvite) {
+    hboltInviteCheckLock.lock()
+    defer { hboltInviteCheckLock.unlock() }
+    hboltInviteCheckCache[hash] = (invite, CFAbsoluteTimeGetCurrent())
+    if hboltInviteCheckCache.count > 500, let oldest = hboltInviteCheckCache.min(by: { $0.value.time < $1.value.time })?.key {
+        hboltInviteCheckCache.removeValue(forKey: oldest)
+    }
+}
+
+private func hboltParseFloodSeconds(_ description: String) -> Int {
+    let digits = description.drop(while: { !$0.isNumber })
+    return Int(digits) ?? 5
+}
