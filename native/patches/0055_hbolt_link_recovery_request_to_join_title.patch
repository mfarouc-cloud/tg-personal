+    // HBOLT 0055: remember the TITLE an invite hash showed while it was valid. A request-to-join link
+    // never reveals its peerId before you are approved, so rememberInvite (peerId) can't fire for it;
+    // the title is the only identifier available at tap time. Later, an expired link can be matched
+    // to a known chat of exactly that title — even one you were since removed from.
+    private static let inviteTitleCacheKey = "hbolt.inviteTitleCache.v1"
+
+    public static func rememberInviteTitle(hash: String, title: String) {
+        let trimmed = title.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !hash.isEmpty, !hash.contains("\t"), !trimmed.isEmpty, !trimmed.contains("\t") else {
+            return
+        }
+        inviteLock.lock()
+        defer { inviteLock.unlock() }
+        var entries: [(hash: String, title: String)] = (defaults.array(forKey: inviteTitleCacheKey) as? [String] ?? []).compactMap { entry in
+            let parts = entry.split(separator: "\t", maxSplits: 1, omittingEmptySubsequences: false)
+            guard parts.count == 2, !parts[0].isEmpty, !parts[1].isEmpty else {
+                return nil
+            }
+            return (String(parts[0]), String(parts[1]))
+        }
+        entries.removeAll(where: { $0.hash == hash })
+        entries.append((hash, trimmed))
+        if entries.count > inviteCacheLimit {
+            entries.removeFirst(entries.count - inviteCacheLimit)
+        }
+        defaults.set(entries.map { "\($0.hash)\t\($0.title)" }, forKey: inviteTitleCacheKey)
+    }
+
+    public static func rememberedInviteTitle(hash: String) -> String? {
+        inviteLock.lock()
+        defer { inviteLock.unlock() }
+        let entries = (defaults.array(forKey: inviteTitleCacheKey) as? [String] ?? [])
+        for entry in entries.reversed() {
+            let parts = entry.split(separator: "\t", maxSplits: 1, omittingEmptySubsequences: false)
+            if parts.count == 2, parts[0] == hash, !parts[1].isEmpty {
+                return String(parts[1])
+            }
+        }
+        return nil
+    }
+
