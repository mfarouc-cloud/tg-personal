 /// target chat's title (and photo), which is then matched against chats the account knows.
+private func hboltExactPeerByTitle(transaction: Transaction, title: String) -> Peer? {
+    let trimmed = title.trimmingCharacters(in: .whitespacesAndNewlines)
+    if trimmed.isEmpty {
+        return nil
+    }
+    for rendered in transaction.searchPeers(query: trimmed, predicate: nil) {
+        guard let peer = rendered.peer, peer is TelegramChannel || peer is TelegramGroup else {
+            continue
+        }
+        if peer.debugDisplayTitle.compare(trimmed, options: .caseInsensitive) == .orderedSame {
+            return peer
+        }
+    }
+    return nil
+}
+
 func hboltRecoverInvite(account: Account, hash: String) -> Signal<Peer?, NoError> {
+    // HBOLT 0055: a title remembered while the link was valid (incl. request-to-join) resolves to an
+    // exact known chat — even one you were removed from — before falling back to preview search.
+    if let title = HBOLTSettings.rememberedInviteTitle(hash: hash), !title.isEmpty {
+        return account.postbox.transaction { transaction -> Peer? in
+            return hboltExactPeerByTitle(transaction: transaction, title: title)
+        }
+        |> mapToSignal { peer -> Signal<Peer?, NoError> in
+            if let peer = peer {
+                return .single(peer)
+            }
+            return hboltRecoverInviteByPreview(account: account, hash: hash)
+        }
+    }
+    return hboltRecoverInviteByPreview(account: account, hash: hash)
+}
