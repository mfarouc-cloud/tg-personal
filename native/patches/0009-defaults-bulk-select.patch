diff --git a/submodules/TelegramCore/Sources/HBOLTBulkSelect.swift b/submodules/TelegramCore/Sources/HBOLTBulkSelect.swift
new file mode 100644
index 000000000..feac61a44
--- /dev/null
+++ b/submodules/TelegramCore/Sources/HBOLTBulkSelect.swift
@@ -0,0 +1,25 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+public extension HBOLTSettings {
+    static var bulkSelect: Bool { return value("hbolt.bulkSelect") }
+
+    /// Ids of every locally stored message in the chat from `start` up to the newest one (max 5000).
+    static func messageIdsFromHereToLatest(account: Account, from start: MessageId) -> Signal<[MessageId], NoError> {
+        return account.postbox.transaction { transaction -> [MessageId] in
+            var ids: [MessageId] = []
+            transaction.scanTopMessages(peerId: start.peerId, namespace: start.namespace, limit: 5000, { message in
+                if message.id.id >= start.id {
+                    ids.append(message.id)
+                    return true
+                }
+                return false
+            })
+            if !ids.contains(start) {
+                ids.append(start)
+            }
+            return ids
+        }
+    }
+}
