+/// Posts an HBOLT status note to the user's own Saved Messages — never into the target chat, where
+/// other members would see it.
+func hboltReportToSaved(account: Account, targetPeerId: PeerId?, text: String) -> Signal<Never, NoError> {
+    return account.postbox.transaction { transaction -> String in
+        var full = "⚡️ HBOLT\n" + text
+        if let targetPeerId = targetPeerId, targetPeerId != account.peerId, let peer = transaction.getPeer(targetPeerId) {
+            full += "\nTo: " + peer.debugDisplayTitle
+        }
+        return full
+    }
+    |> mapToSignal { full -> Signal<Never, NoError> in
+        let message: EnqueueMessage = .message(text: full, attributes: [], inlineStickers: [:], mediaReference: nil, threadId: nil, replyToMessageId: nil, replyToStoryId: nil, localGroupingKey: nil, correlationId: nil, bubbleUpEmojiOrStickersets: [])
+        return enqueueMessages(account: account, peerId: account.peerId, messages: [message]) |> ignoreValues
+    }
+}
+
+/// True if any source message comes from a chat with "restrict saving content".
+private func hboltAnyProtected(_ messages: [Message]) -> Bool {
+    for message in messages {
+        if HBOLTSettings.isProtected(message.id.peerId.toInt64()) {
+            return true
+        }
+    }
+    return false
+}
+
+private final class HBOLTReferenceTask {
+    var albums = 0
+    var ids: [MessageId] = []
+    var sourceForId: [MessageId: Message] = [:]
+}
+
+/// Fast path for chats WITHOUT content protection: each item is re-sent as a new message that points
+/// at the media already on Telegram's servers (inputMediaPhoto / inputMediaDocument by id), so nothing
+/// is downloaded or uploaded — instant even for large videos — while still regrouping into albums of
+/// up to 10 and carrying no "Forwarded from". Batches are awaited one by one so the send queue never
+/// floods; Telegram's own sender handles FLOOD_WAIT and retries. Anything the server refuses (e.g. the
+/// user was removed from the source chat meanwhile) is removed from the target and retried through the
+/// download + re-upload pipeline, so the kick-resilience of the old path is kept.
+private func hboltReferenceSendRun(account: Account, messages: [Message], toPeerId: PeerId, toThreadId: Int64?, asAlbums: Bool, label: String) -> Signal<Never, NoError> {
+    let task = HBOLTReferenceTask()
+    let total = messages.count
+    let chunkSize = asAlbums ? 10 : 20
+    var chain: Signal<Never, NoError> = .complete()
+    var start = 0
+    while start < messages.count {
+        let upper = min(start + chunkSize, messages.count)
+        let chunk = Array(messages[start ..< upper])
+        start = upper
+        var items: [(Message, Media)] = []
+        for message in chunk {
+            if let media = message.media.first(where: { $0 is TelegramMediaImage || $0 is TelegramMediaFile }) {
+                items.append((message, media))
+            }
+        }
+        if items.isEmpty {
+            continue
+        }
+        let groupId: Int64? = (asAlbums && items.count >= 2) ? Int64.random(in: Int64.min ... Int64.max) : nil
+        if groupId != nil {
+            task.albums += 1
+        }
+        let batch: [EnqueueMessage] = items.map { item -> EnqueueMessage in
+            let (message, media) = item
+            return .message(text: message.text, attributes: hboltStripProvenance(message.attributes), inlineStickers: [:], mediaReference: .message(message: MessageReference(message), media: media), threadId: toThreadId, replyToMessageId: nil, replyToStoryId: nil, localGroupingKey: groupId, correlationId: nil, bubbleUpEmojiOrStickersets: [])
+        }
+        let sources = items.map { $0.0 }
+        let step: Signal<Never, NoError> = enqueueMessages(account: account, peerId: toPeerId, messages: batch)
+        |> mapToSignal { ids -> Signal<Never, NoError> in
+            var newIds: [MessageId] = []
+            for (index, id) in ids.enumerated() {
+                if let id = id, index < sources.count {
+                    newIds.append(id)
+                    task.ids.append(id)
+                    task.sourceForId[id] = sources[index]
+                }
+            }
+            return hboltAwaitSent(account: account, ids: newIds)
+        }
+        chain = chain |> then(step)
+    }
+    let completion: Signal<Never, NoError> = account.postbox.transaction { transaction -> [Message] in
+        // Collect what the server refused and take those failed bubbles out of the target chat.
+        var failedIds: [MessageId] = []
+        var failedSources: [Message] = []
+        for id in task.ids {
+            if let message = transaction.getMessage(id), message.flags.contains(.Failed), let source = task.sourceForId[id] {
+                failedIds.append(id)
+                failedSources.append(source)
+            }
+        }
+        if !failedIds.isEmpty {
+            _internal_deleteMessages(transaction: transaction, mediaBox: account.postbox.mediaBox, ids: failedIds)
+        }
+        return failedSources
+    }
+    |> mapToSignal { failedSources -> Signal<Never, NoError> in
+        let sent = task.ids.count - failedSources.count
+        var text = "Done. Sent \(sent) of \(total) items"
+        if asAlbums {
+            text += " in \(task.albums) albums"
+        }
+        text += " via \(label) (fast, no re-upload)."
+        if failedSources.isEmpty {
+            return hboltReportToSaved(account: account, targetPeerId: toPeerId, text: text)
+        }
+        text += " \(failedSources.count) were refused by the server — retrying them now with download + re-upload."
+        let retry = failedSources.sorted(by: { $0.index < $1.index })
+        return hboltReportToSaved(account: account, targetPeerId: toPeerId, text: text)
+        |> then(hboltSonicRun(account: account, messages: retry, toPeerId: toPeerId, toThreadId: toThreadId, label: label + " retry", forceReupload: true))
+    }
+    return chain |> then(completion)
+}
