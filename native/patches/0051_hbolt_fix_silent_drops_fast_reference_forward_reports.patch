+// MARK: - HBOLT 0051: progress-aware download wait, reports, and the by-reference fast path.
+
+private final class HBOLTFetchWaiter {
+    let queue = Queue()
+    private let stallTimeout: Double
+    private let deadline: Double
+    private let onDone: () -> Void
+    private var finished = false
+    private var queuedOnly = true
+    private var timer: SwiftSignalKit.Timer?
+
+    init(stallTimeout: Double, hardLimit: Double, onDone: @escaping () -> Void) {
+        self.stallTimeout = stallTimeout
+        self.deadline = CFAbsoluteTimeGetCurrent() + hardLimit
+        self.onDone = onDone
+    }
+
+    // All methods below run on `queue`.
+    func arm() {
+        if self.finished {
+            return
+        }
+        self.timer?.invalidate()
+        let timer = SwiftSignalKit.Timer(timeout: self.stallTimeout, repeat: false, completion: { [weak self] in
+            self?.timerFired()
+        }, queue: self.queue)
+        self.timer = timer
+        timer.start()
+    }
+
+    private func timerFired() {
+        if self.finished {
+            return
+        }
+        // Waiting for a free download slot is not a stall; only give up on a download that is
+        // actively fetching yet made no progress, or once the overall hard limit is reached.
+        if self.queuedOnly && CFAbsoluteTimeGetCurrent() < self.deadline {
+            self.arm()
+        } else {
+            self.finish()
+        }
+    }
+
+    func update(_ status: MediaResourceStatus) {
+        switch status {
+        case .Local:
+            self.finish()
+        case let .Fetching(isActive, _):
+            self.queuedOnly = !isActive
+            self.arm()
+        case .Remote, .Paused:
+            self.queuedOnly = true
+            self.arm()
+        }
+    }
+
+    func finish() {
+        if self.finished {
+            return
+        }
+        self.finished = true
+        self.timer?.invalidate()
+        self.timer = nil
+        self.onDone()
+    }
+
+    func cancel() {
+        self.finished = true
+        self.timer?.invalidate()
+        self.timer = nil
+    }
+}
+
+/// Completes once `resource` is fully on disk, or once it is clear it will not get there: the fetch
+/// ended without the data (access revoked / error), it made no progress for `stallTimeout` seconds
+/// while actively downloading, or `hardLimit` passed. Never cuts off a big file that is still moving.
+func hboltFetchUntilCached(account: Account, message: Message, media: Media, resource: MediaResource, contentType: MediaResourceUserContentType, stallTimeout: Double = 300.0, hardLimit: Double = 3.0 * 3600.0) -> Signal<Void, NoError> {
+    let mediaBox = account.postbox.mediaBox
+    if mediaBox.completedResourcePath(resource) != nil {
+        return .single(Void())
+    }
+    let fetch: Signal<Never, NoError> = fetchedMediaResource(mediaBox: mediaBox, userLocation: .peer(message.id.peerId), userContentType: contentType, reference: .media(media: .message(message: MessageReference(message), media: media), resource: resource))
+    |> ignoreValues
+    |> `catch` { _ -> Signal<Never, NoError> in .complete() }
+    return Signal<Void, NoError> { subscriber in
+        let waiter = HBOLTFetchWaiter(stallTimeout: stallTimeout, hardLimit: hardLimit, onDone: {
+            subscriber.putNext(Void())
+            subscriber.putCompletion()
+        })
+        waiter.queue.async {
+            waiter.arm()
+        }
+        let fetchDisposable = fetch.start(completed: {
+            // The fetch ended. If the data made it, the data signal below finishes first; if not
+            // (error, access revoked) there is nothing left to wait for.
+            waiter.queue.after(2.0) {
+                waiter.finish()
+            }
+        })
+        let statusDisposable = (mediaBox.resourceStatus(resource)
+        |> distinctUntilChanged).start(next: { status in
+            waiter.queue.async {
+                waiter.update(status)
+            }
+        })
+        let dataDisposable = (mediaBox.resourceData(resource, option: .complete(waitUntilFetchStatus: false))
+        |> filter { $0.complete }
+        |> take(1)).start(next: { _ in
+            waiter.queue.async {
+                waiter.finish()
+            }
+        })
+        return ActionDisposable {
+            fetchDisposable.dispose()
+            statusDisposable.dispose()
+            dataDisposable.dispose()
+            waiter.queue.async {
+                waiter.cancel()
+            }
+        }
+    }
+}
