+public extension HBOLTSettings {
+    /// When forwarding a single photo/video into a private chat, re-upload it as view-once.
+    static var viewOnceToPrivate: Bool { return value("hbolt.viewOnceToPrivate") }
+}
+
+/// HBOLT: for a private (user) target, rewrite single-photo/single-video forwards into
+/// re-uploaded view-once messages. Everything else passes through unchanged.
+func hboltRewriteViewOnce(account: Account, peerId: PeerId, messages: [EnqueueMessage]) -> Signal<[EnqueueMessage], NoError> {
+    guard HBOLTSettings.viewOnceToPrivate, peerId.namespace == Namespaces.Peer.CloudUser else {
+        return .single(messages)
+    }
+    let hasForward = messages.contains(where: { if case .forward = $0 { return true } else { return false } })
+    if !hasForward {
+        return .single(messages)
+    }
+    return account.postbox.transaction { transaction -> [Message?] in
+        return messages.map { item -> Message? in
+            if case let .forward(source, _, _, _, _) = item {
+                return transaction.getMessage(source)
+            }
+            return nil
+        }
+    }
+    |> mapToSignal { sources -> Signal<[EnqueueMessage], NoError> in
+        var signals: [Signal<EnqueueMessage, NoError>] = []
+        for (index, item) in messages.enumerated() {
+            if case let .forward(_, threadId, _, attributes, correlationId) = item, let source = sources[index], hboltIsSingleVisualMedia(source) {
+                signals.append(hboltResend(account: account, message: source, threadId: threadId, grouping: .none, attributes: attributes, correlationId: correlationId, groupingKeys: [:], viewOnce: true))
+            } else {
+                signals.append(.single(item))
+            }
+        }
+        return combineLatest(signals)
+    }
+}
+
+private func hboltIsSingleVisualMedia(_ message: Message) -> Bool {
+    let visual = message.media.filter { ($0 is TelegramMediaImage) || (($0 as? TelegramMediaFile)?.isVideo ?? false) }
+    let others = message.media.filter { !($0 is TelegramMediaImage) && !($0 is TelegramMediaFile) }
+    return visual.count == 1 && others.isEmpty && message.groupingKey == nil
+}
