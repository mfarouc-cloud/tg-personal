+    /// Keep the previous text of messages that get edited (viewable from the message menu).
+    public static var keepEdits: Bool {
+        get { return defaults.bool(forKey: "hbolt.keepEdits") }
+        set { defaults.set(newValue, forKey: "hbolt.keepEdits") }
+    }
+
+    private static let editsQueue = DispatchQueue(label: "hbolt.edits")
+    private static var editsCache: [String: [String]]?
+    private static var editsURL: URL? {
+        guard let base = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first else { return nil }
+        try? FileManager.default.createDirectory(at: base, withIntermediateDirectories: true)
+        return base.appendingPathComponent("hbolt-edit-history.json")
+    }
+    private static func loadEdits() -> [String: [String]] {
+        if let c = editsCache { return c }
+        var result: [String: [String]] = [:]
+        if let url = editsURL, let data = try? Data(contentsOf: url), let decoded = try? JSONDecoder().decode([String: [String]].self, from: data) {
+            result = decoded
+        }
+        editsCache = result
+        return result
+    }
+
+    /// Called just before an edit replaces a message's text.
+    public static func recordEdit(peerId: Int64, messageId: Int32, oldText: String) {
+        guard keepEdits, !oldText.isEmpty else { return }
+        editsQueue.async {
+            var all = loadEdits()
+            let key = "\(peerId):\(messageId)"
+            var list = all[key] ?? []
+            if list.last == oldText { return }
+            list.append(oldText)
+            if list.count > 50 { list.removeFirst(list.count - 50) }
+            all[key] = list
+            if all.count > 20000, let k = all.keys.first { all.removeValue(forKey: k) }
+            editsCache = all
+            if let url = editsURL, let data = try? JSONEncoder().encode(all) { try? data.write(to: url, options: .atomic) }
+        }
+    }
+
+    /// Previous versions (oldest first) of a message's text.
+    public static func editHistory(peerId: Int64, messageId: Int32) -> [String] {
+        return editsQueue.sync { loadEdits()["\(peerId):\(messageId)"] ?? [] }
+    }
+
