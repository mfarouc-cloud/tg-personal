+// HBOLT 0053: like hboltAwaitSent but emits one Void when the ids have left the unsent queue, so a
+// following mapToSignal (which runs on an emitted value) can inspect the results. Avoids mapping over
+// a Never signal, which the build rejects as "will never be executed".
+private func hboltAwaitSentVoid(account: Account, ids: [MessageId]) -> Signal<Void, NoError> {
+    let pending = Set(ids)
+    if pending.isEmpty {
+        return .single(Void())
+    }
+    return account.postbox.unsentMessageIdsView()
+    |> filter { view in view.ids.isDisjoint(with: pending) }
+    |> take(1)
+    |> map { _ in Void() }
+}
