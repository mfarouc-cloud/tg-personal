+/// Local (offline) fallback: read the cached tag index straight from Postbox. Used when the server
+/// media search returns nothing — e.g. a peer the server now reports as unavailable after a kick,
+/// but whose recently-synced media is still in the local database.
+private func hboltLocalMediaMessages(account: Account, peerId: PeerId, threadId: Int64?, tags: [MessageTags]) -> Signal<[Message], NoError> {
+    return account.postbox.transaction { transaction -> [Message] in
+        var seen = Set<MessageId>()
+        var messages: [Message] = []
+        for tag in tags {
+            for index in transaction.getMessageIndicesWithTag(peerId: peerId, threadId: threadId, namespace: Namespaces.Message.Cloud, tag: tag) {
+                if seen.contains(index.id) {
+                    continue
+                }
+                if let message = transaction.getMessage(index.id) {
+                    seen.insert(index.id)
+                    messages.append(message)
+                }
+            }
+        }
+        return messages
+    }
+}
+
