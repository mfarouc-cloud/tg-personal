     |> mapToSignal { videoMessages, photoMessages -> Signal<Never, NoError> in
-        let messages = hboltSonicFilteredSorted(videoMessages + photoMessages, fromThreadId: fromThreadId)
-        return hboltSonicRun(account: account, messages: messages, toPeerId: toPeerId, toThreadId: toThreadId, label: "Sonic Bulk")
+        let serverMessages = hboltSonicFilteredSorted(videoMessages + photoMessages, fromThreadId: fromThreadId)
+        if !serverMessages.isEmpty {
+            return hboltSonicRun(account: account, messages: serverMessages, toPeerId: toPeerId, toThreadId: toThreadId, label: "Sonic Bulk")
+        }
+        // Offline fallback: the peer may be server-unavailable (kick) but still cached locally.
+        return hboltLocalMediaMessages(account: account, peerId: fromPeerId, threadId: fromThreadId, tags: [.video, .photo])
+        |> mapToSignal { localRaw -> Signal<Never, NoError> in
