+    private var hboltForwardProgressController: UndoOverlayController?
+    private var hboltForwardProgressDisposable: Disposable?
+
+    // HBOLT: window-level "Forwarding N…" counter driven by the real unsent-message queue.
+    // Shown for bulk sends/forwards into this chat; floats over whatever screen is open and
+    // ticks down as Telegram's send queue drains, then dismisses.
+    private func hboltShowForwardProgress(peerId: PeerId, total: Int) {
+        self.hboltForwardProgressDisposable?.dispose()
+        let makeContent: (Int) -> UndoOverlayContent = { remaining in
+            return .info(title: nil, text: "Forwarding \(remaining)…", timeout: nil, customUndoText: nil)
+        }
+        if let existing = self.hboltForwardProgressController {
+            existing.content = makeContent(total)
+        } else {
+            let controller = UndoOverlayController(presentationData: self.presentationData, content: makeContent(total), elevatedLayout: false, position: .top, action: { _ in return false })
+            self.hboltForwardProgressController = controller
+            self.present(controller, in: .window(.root))
+        }
+        self.hboltForwardProgressDisposable = (self.context.account.postbox.unsentMessageIdsView()
+        |> deliverOnMainQueue).startStrict(next: { [weak self] view in
+            guard let self else {
+                return
+            }
+            let remaining = view.ids.filter({ $0.peerId == peerId }).count
+            if remaining <= 0 {
+                self.hboltForwardProgressController?.dismiss()
+                self.hboltForwardProgressController = nil
+                self.hboltForwardProgressDisposable?.dispose()
+                self.hboltForwardProgressDisposable = nil
+            } else {
+                self.hboltForwardProgressController?.content = makeContent(remaining)
+            }
+        })
+    }
