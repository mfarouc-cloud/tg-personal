+/// Drains the server-side media search to completion, accumulating every matching message.
+private func hboltDrainMediaSearch(account: Account, location: SearchMessagesLocation, state: SearchMessagesState?, accumulated: [Message]) -> Signal<[Message], NoError> {
+    return TelegramEngine(account: account).messages.searchMessages(location: location, query: "", state: state, limit: 100)
+    |> mapToSignal { result, updatedState -> Signal<[Message], NoError> in
+        var all = accumulated
+        all.append(contentsOf: result.messages)
+        if result.completed || result.messages.isEmpty {
+            return .single(all)
+        } else {
+            return hboltDrainMediaSearch(account: account, location: location, state: updatedState, accumulated: all)
+        }
+    }
+}
