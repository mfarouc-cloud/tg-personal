+private func hboltFilteredSortedMedia(_ messages: [Message], fromThreadId: Int64?, kind: HBOLTBulkMediaKind) -> [Message] {
+    var seen = Set<MessageId>()
+    var filtered: [Message] = []
+    for message in messages {
+        if seen.contains(message.id) {
+            continue
+        }
+        if let fromThreadId = fromThreadId, message.threadId != fromThreadId {
+            continue
+        }
+        let matches: Bool
+        switch kind {
+        case .photo:
+            matches = message.media.contains(where: { $0 is TelegramMediaImage })
+        case .video:
+            matches = message.media.contains(where: { ($0 as? TelegramMediaFile)?.isVideo ?? false })
+        }
+        if !matches {
+            continue
+        }
+        seen.insert(message.id)
+        filtered.append(message)
+    }
+    return filtered.sorted(by: { $0.index < $1.index })
+}
