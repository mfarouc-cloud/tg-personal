+// MARK: - Selected Bulk: the Sonic producer-consumer pipeline scoped to explicitly selected items.
+
+private func hboltSelectedFilteredSorted(_ messages: [Message]) -> [Message] {
+    var seen = Set<MessageId>()
+    var out: [Message] = []
+    for message in messages {
+        if seen.contains(message.id) {
+            continue
+        }
+        let ok = message.media.contains(where: { $0 is TelegramMediaImage || (($0 as? TelegramMediaFile)?.isVideo ?? false) })
+        if !ok {
+            continue
+        }
+        seen.insert(message.id)
+        out.append(message)
+    }
+    return out.sorted(by: { $0.index < $1.index })
+}
+
+/// Selected Bulk: identical pipeline to Sonic Bulk (bounded pre-cache waves, detached local send,
+/// forced 10-item albums, per-wave eviction, kick-immunity, completion count) but fed only the
+/// explicitly selected message ids — no searchMessages drain of the whole chat.
+public func hboltSelectedBulkForward(account: Account, messageIds: [MessageId], toPeerId: PeerId, toThreadId: Int64?) -> Signal<Never, NoError> {
+    if messageIds.isEmpty {
+        return .complete()
+    }
+    return account.postbox.transaction { transaction -> [Message] in
+        var result: [Message] = []
+        for id in messageIds {
+            if let message = transaction.getMessage(id) {
+                result.append(message)
+            }
+        }
+        return result
+    }
+    |> mapToSignal { rawMessages -> Signal<Never, NoError> in
+        let messages = hboltSelectedFilteredSorted(rawMessages)
+        if messages.isEmpty {
+            return .complete()
+        }
+        let windowItems = 30
+        var waves: [[Message]] = []
+        var index = 0
+        while index < messages.count {
+            waves.append(Array(messages[index ..< min(index + windowItems, messages.count)]))
+            index += windowItems
+        }
+        let counter = HBOLTSonicCounter()
+        let process = hboltSonicProcessWaves(account: account, waves: waves, index: 0, toPeerId: toPeerId, toThreadId: toThreadId, counter: counter)
+        let completion: Signal<Never, NoError> = Signal<Void, NoError>.single(Void())
+        |> mapToSignal { _ -> Signal<Never, NoError> in
+            let text = "Done. Successfully forwarded \(counter.committed) items in \(counter.albums) albums via Selected Bulk."
+            let message: EnqueueMessage = .message(text: text, attributes: [], inlineStickers: [:], mediaReference: nil, threadId: toThreadId, replyToMessageId: nil, replyToStoryId: nil, localGroupingKey: nil, correlationId: nil, bubbleUpEmojiOrStickersets: [])
+            return enqueueMessages(account: account, peerId: toPeerId, messages: [message]) |> ignoreValues
+        }
+        return process |> then(completion)
+    }
+}
