+    // HBOLT: Selected Bulk — 1-tap from the choice sheet straight to the target picker, strict
+    // 10-item albums, scoped to the explicitly selected items via the Sonic fast-lane pipeline.
+    func hboltSelectedBulkStart(messageIds: Set<EngineMessage.Id>) {
