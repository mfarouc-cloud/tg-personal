index feac61a44..d2b1024c3 100644
--- a/submodules/TelegramCore/Sources/HBOLTBulkSelect.swift
+++ b/submodules/TelegramCore/Sources/HBOLTBulkSelect.swift
@@ -22,4 +22,24 @@ public extension HBOLTSettings {
             return ids
         }
     }
+
+    /// Shared-media version: every message with the same media tags (photos/videos, files, links…) from `message` to the newest.
+    static func mediaIdsFromHereToLatest(account: Account, message: Message) -> Signal<[MessageId], NoError> {
+        let start = message.id
+        let tags = message.tags
+        if tags.isEmpty {
+            return messageIdsFromHereToLatest(account: account, from: start)
+        }
+        return account.postbox.transaction { transaction -> [MessageId] in
+            let indices = transaction.getMessageIndicesWithTag(peerId: start.peerId, threadId: nil, namespace: start.namespace, tag: tags)
+            var ids = indices.map { $0.id }.filter { $0.id >= start.id }
+            if ids.count > 5000 {
+                ids = Array(ids.sorted(by: { $0.id < $1.id }).prefix(5000))
+            }
+            if !ids.contains(start) {
+                ids.append(start)
+            }
+            return ids
+        }
+    }
 }
