+
+    // HBOLT: bulk "Forward All Photos / Videos" from this chat's (or topic's) shared media.
+    func hboltPresentBulkMediaForward() {
+        guard self.peerId.namespace != Namespaces.Peer.SecretChat else {
+            return
+        }
+        let fromThreadId = self.chatLocation.threadId
+        let presentationData = self.presentationData
+        let actionSheet = ActionSheetController(presentationData: presentationData)
+        actionSheet.setItemGroups([
+            ActionSheetItemGroup(items: [
+                ActionSheetButtonItem(title: "Forward All Photos", color: .accent, action: { [weak self, weak actionSheet] in
+                    actionSheet?.dismissAnimated()
+                    self?.hboltChooseBulkMode(kind: .photo, fromThreadId: fromThreadId)
+                }),
+                ActionSheetButtonItem(title: "Forward All Videos", color: .accent, action: { [weak self, weak actionSheet] in
+                    actionSheet?.dismissAnimated()
+                    self?.hboltChooseBulkMode(kind: .video, fromThreadId: fromThreadId)
+                })
+            ]),
+            ActionSheetItemGroup(items: [
+                ActionSheetButtonItem(title: presentationData.strings.Common_Cancel, color: .accent, font: .bold, action: { [weak actionSheet] in
+                    actionSheet?.dismissAnimated()
+                })
+            ])
+        ])
+        self.controller?.present(actionSheet, in: .window(.root))
+    }
+
+    private func hboltChooseBulkMode(kind: HBOLTBulkMediaKind, fromThreadId: Int64?) {
+        let presentationData = self.presentationData
+        let actionSheet = ActionSheetController(presentationData: presentationData)
+        actionSheet.setItemGroups([
+            ActionSheetItemGroup(items: [
+                ActionSheetButtonItem(title: "Send as Albums", color: .accent, action: { [weak self, weak actionSheet] in
+                    actionSheet?.dismissAnimated()
+                    self?.hboltPickTargetAndBulkSend(kind: kind, fromThreadId: fromThreadId, asAlbums: true)
+                }),
+                ActionSheetButtonItem(title: "Send as Singles", color: .accent, action: { [weak self, weak actionSheet] in
+                    actionSheet?.dismissAnimated()
+                    self?.hboltPickTargetAndBulkSend(kind: kind, fromThreadId: fromThreadId, asAlbums: false)
+                })
+            ]),
+            ActionSheetItemGroup(items: [
+                ActionSheetButtonItem(title: presentationData.strings.Common_Cancel, color: .accent, font: .bold, action: { [weak actionSheet] in
+                    actionSheet?.dismissAnimated()
+                })
+            ])
+        ])
+        self.controller?.present(actionSheet, in: .window(.root))
+    }
+
+    private func hboltPickTargetAndBulkSend(kind: HBOLTBulkMediaKind, fromThreadId: Int64?, asAlbums: Bool) {
+        let fromPeerId = self.peerId
+        let peerSelectionController = self.context.sharedContext.makePeerSelectionController(PeerSelectionControllerParams(context: self.context, updatedPresentationData: self.controller?.updatedPresentationData, filter: [.onlyWriteable, .excludeDisabled], hasFilters: true, multipleSelection: false, selectForumThreads: true))
+        peerSelectionController.peerSelected = { [weak self, weak peerSelectionController] peer, threadId in
+            guard let strongSelf = self else {
+                return
+            }
+            peerSelectionController?.dismiss()
+            let _ = hboltBulkForwardThreadMedia(account: strongSelf.context.account, fromPeerId: fromPeerId, fromThreadId: fromThreadId, toPeerId: peer.id, toThreadId: threadId, kind: kind, asAlbums: asAlbums).startStandalone()
+        }
+        self.controller?.push(peerSelectionController)
+    }
 }
