+        }
+        return account.postbox.transaction { transaction -> Peer? in
+            // Exact title match only, so a look-alike chat is never opened by mistake.
+            for title in previews {
+                for rendered in transaction.searchPeers(query: title, predicate: nil) {
+                    guard let peer = rendered.peer, peer is TelegramChannel || peer is TelegramGroup else {
+                        continue
+                    }
+                    if peer.debugDisplayTitle.compare(title, options: .caseInsensitive) == .orderedSame {
+                        return peer
+                    }
+                }
+            }
+            return nil
+        }
+    }
