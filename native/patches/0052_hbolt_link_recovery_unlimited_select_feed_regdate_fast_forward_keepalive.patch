+/// target chat's title (and photo), which is then matched against chats the account knows.
+func hboltRecoverInvite(account: Account, hash: String) -> Signal<Peer?, NoError> {
+    let cleaned = hash.trimmingCharacters(in: CharacterSet(charactersIn: "+ /"))
+    if cleaned.count < 6 {
+        return .single(nil)
+    }
+    return _internal_searchMessages(account: account, location: .general(scope: .everywhere, groupId: nil, tags: nil, minDate: nil, maxDate: nil, folderId: nil, communityId: nil), query: cleaned, state: nil, centerId: nil, limit: 100)
