 public func enqueueMessages(account: Account, peerId: PeerId, messages: [EnqueueMessage]) -> Signal<[MessageId?], NoError> {
+    let forwardCount = messages.filter({ if case .forward = $0 { return true } else { return false } }).count
+    if forwardCount > 10 {
+        // HBOLT: bulk forwarding goes out in chunks of 10, 500 ms apart (flood-safe, UI stays responsive).
+        var chunks: [[EnqueueMessage]] = []
+        var index = 0
+        while index < messages.count {
+            chunks.append(Array(messages[index ..< min(index + 10, messages.count)]))
+            index += 10
+        }
+        return hboltEnqueueChunks(account: account, peerId: peerId, chunks: chunks[...], isFirst: true)
+    }
     return hboltRewriteProtectedForwards(account: account, messages: messages)
     |> mapToSignal { messages -> Signal<[MessageId?], NoError> in
         return hboltEnqueueMessagesImpl(account: account, peerId: peerId, messages: messages)
     }
 }
 
+private func hboltEnqueueChunks(account: Account, peerId: PeerId, chunks: ArraySlice<[EnqueueMessage]>, isFirst: Bool) -> Signal<[MessageId?], NoError> {
+    guard let chunk = chunks.first else {
+        return .single([])
+    }
+    let rest = chunks.dropFirst()
+    let start: Signal<Void, NoError> = isFirst ? .single(Void()) : (.single(Void()) |> delay(0.5, queue: Queue.concurrentDefaultQueue()))
+    return start
+    |> mapToSignal { _ -> Signal<[MessageId?], NoError> in
+        return hboltRewriteProtectedForwards(account: account, messages: chunk)
+        |> mapToSignal { messages -> Signal<[MessageId?], NoError> in
+            return hboltEnqueueMessagesImpl(account: account, peerId: peerId, messages: messages)
+        }
+    }
+    |> take(1)
+    |> mapToSignal { ids -> Signal<[MessageId?], NoError> in
+        return hboltEnqueueChunks(account: account, peerId: peerId, chunks: rest, isFirst: false)
+        |> map { restIds -> [MessageId?] in
+            return ids + restIds
+        }
+    }
+}
