diff --git a/submodules/TelegramCore/Sources/HBOLTSessionKeychain.swift b/submodules/TelegramCore/Sources/HBOLTSessionKeychain.swift
new file mode 100644
index 000000000..78427e073
--- /dev/null
+++ b/submodules/TelegramCore/Sources/HBOLTSessionKeychain.swift
@@ -0,0 +1,64 @@
+import Foundation
+import Security
+
+/// HBOLT: keeps each logged-in account's AccountBackupData (user id, master DC, DC auth keys)
+/// in the iOS Keychain, bound to THIS device only (never synced to iCloud), so a reinstall
+/// can rebuild the accounts without a new login code. Telegram itself rebuilds an account
+/// from AccountBackupData when its database is empty.
+public enum HBOLTSessionKeychain {
+    private static let service = "hbolt.sessions"
+    private static let account = "accounts"
+
+    public static var enabled: Bool {
+        return HBOLTSettings.value("hbolt.keepLogin")
+    }
+
+    private static var baseQuery: [String: Any] {
+        return [
+            kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: service,
+            kSecAttrAccount as String: account,
+            kSecAttrSynchronizable as String: kCFBooleanFalse as Any
+        ]
+    }
+
+    public static func save(_ backups: [AccountBackupData]) {
+        if !enabled || backups.isEmpty {
+            clear()
+            return
+        }
+        guard let data = try? JSONEncoder().encode(backups) else {
+            return
+        }
+        if let existing = loadData(), existing == data {
+            return
+        }
+        SecItemDelete(baseQuery as CFDictionary)
+        var query = baseQuery
+        query[kSecValueData as String] = data
+        query[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly
+        SecItemAdd(query as CFDictionary, nil)
+    }
+
+    public static func load() -> [AccountBackupData] {
+        guard enabled, let data = loadData() else {
+            return []
+        }
+        return (try? JSONDecoder().decode([AccountBackupData].self, from: data)) ?? []
+    }
+
+    public static func clear() {
+        SecItemDelete(baseQuery as CFDictionary)
+    }
+
+    private static func loadData() -> Data? {
+        var query = baseQuery
+        query[kSecReturnData as String] = true
+        query[kSecMatchLimit as String] = kSecMatchLimitOne
+        var result: AnyObject?
+        guard SecItemCopyMatching(query as CFDictionary, &result) == errSecSuccess else {
+            return nil
+        }
+        return result as? Data
+    }
+}
