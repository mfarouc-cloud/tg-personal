+                        .sortOrder(AccountSortOrderAttribute(order: Int32(index)))
+                    ])
+                    if firstId == nil {
+                        firstId = id
+                    }
+                }
+                if let firstId = firstId {
+                    transaction.setCurrentId(firstId)
+                }
+            }).startStandalone()
+        }
