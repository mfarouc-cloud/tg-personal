+        // HBOLT: after a reinstall the account list is empty — rebuild accounts from the device Keychain backup.
+        let hboltRestored = HBOLTSessionKeychain.load()
+        if !hboltRestored.isEmpty {
+            let _ = accountManager.transaction({ transaction -> Void in
+                if !transaction.getRecords().isEmpty {
+                    return
+                }
+                var firstId: AccountRecordId?
+                for (index, backup) in hboltRestored.enumerated() {
+                    let id = transaction.createRecord([
