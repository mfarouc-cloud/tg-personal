+/// Pulls one item's media into the local cache (or resolves immediately if already cached). Bounded
+/// by a timeout so one stuck item can't stall the wave; emits once done either way.
+private func hboltBulkPrecache(account: Account, message: Message) -> Signal<Void, NoError> {
+    guard let media = message.media.first(where: { $0 is TelegramMediaImage || $0 is TelegramMediaFile }), let (resource, contentType) = hboltBulkResource(media) else {
+        return .single(Void())
+    }
+    let mediaBox = account.postbox.mediaBox
+    if mediaBox.completedResourcePath(resource) != nil {
+        return .single(Void())
+    }
+    let fetch: Signal<Never, NoError> = fetchedMediaResource(mediaBox: mediaBox, userLocation: .peer(message.id.peerId), userContentType: contentType, reference: .media(media: .message(message: MessageReference(message), media: media), resource: resource))
+    |> ignoreValues
+    |> `catch` { _ -> Signal<Never, NoError> in .complete() }
+    let ready = mediaBox.resourceData(resource, option: .complete(waitUntilFetchStatus: true))
+    |> filter { $0.complete }
+    |> take(1)
+    |> map { _ in Void() }
+    return Signal<Void, NoError> { subscriber in
+        let fetchDisposable = fetch.start()
+        let dataDisposable = ready.start(next: { _ in
+            subscriber.putNext(Void())
+            subscriber.putCompletion()
+        })
+        return ActionDisposable {
+            fetchDisposable.dispose()
+            dataDisposable.dispose()
         }
     }
-    if !protectedMessages.isEmpty {
-        parts.append(hboltBulkProtectedAlbumSignal(account: account, toPeerId: toPeerId, toThreadId: toThreadId, messages: protectedMessages, forcedGroupingKey: groupingKey))
+    |> timeout(180.0, queue: Queue.concurrentDefaultQueue(), alternate: .single(Void()))
+}
