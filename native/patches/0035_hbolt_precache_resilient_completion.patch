+/// Aggressive pre-cache of the whole set in bounded-parallel waves (fast-lane, never serialized
+/// behind the upload) so as much as possible is grabbed before any access revocation.
+private func hboltBulkPrecacheAll(account: Account, messages: [Message], concurrency: Int) -> Signal<Never, NoError> {
+    if messages.isEmpty {
+        return .complete()
     }
     var signal: Signal<Never, NoError> = .complete()
-    for part in parts {
-        signal = signal |> then(part)
+    var index = 0
+    while index < messages.count {
+        let window = Array(messages[index ..< min(index + concurrency, messages.count)])
+        let wave: Signal<Never, NoError> = combineLatest(window.map { hboltBulkPrecache(account: account, message: $0) })
+        |> take(1)
+        |> ignoreValues
+        signal = signal |> then(wave)
+        index += concurrency
     }
     return signal
 }
 
