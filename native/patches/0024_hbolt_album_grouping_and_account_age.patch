 public extension HBOLTSettings {
     /// When forwarding a single photo/video into a private chat, re-upload it as view-once.
     static var viewOnceToPrivate: Bool { return value("hbolt.viewOnceToPrivate") }
+    /// Re-upload forwarded photos/videos and bundle them into native albums of up to 10.
+    static var groupForwardAlbums: Bool { return value("hbolt.groupForwardAlbums") }
+}
+
+private func hboltIsAlbumableMedia(_ message: Message) -> Bool {
+    // Exactly one photo or video and nothing else — the only things Telegram albums accept together.
+    guard message.media.count == 1, let media = message.media.first else {
+        return false
+    }
+    if media is TelegramMediaImage {
+        return true
+    }
+    if let file = media as? TelegramMediaFile, file.isVideo {
+        return true
+    }
+    return false
+}
+
+/// HBOLT: opt-in. Re-upload forwarded photos/videos and group them into albums of up to 10,
+/// even when the originals were standalone messages. Non-media items pass through unchanged.
+func hboltRewriteGroupAlbums(account: Account, peerId: PeerId, messages: [EnqueueMessage]) -> Signal<[EnqueueMessage], NoError> {
+    guard HBOLTSettings.groupForwardAlbums else {
+        return .single(messages)
+    }
+    let forwardCount = messages.reduce(0) { acc, item in
+        if case .forward = item { return acc + 1 } else { return acc }
+    }
+    if forwardCount < 2 {
+        return .single(messages)
+    }
+    return account.postbox.transaction { transaction -> [Message?] in
+        return messages.map { item -> Message? in
+            if case let .forward(source, _, _, _, _) = item {
+                return transaction.getMessage(source)
+            }
+            return nil
+        }
+    }
+    |> mapToSignal { sources -> Signal<[EnqueueMessage], NoError> in
+        var mediaIndices: [Int] = []
+        for (index, item) in messages.enumerated() {
+            if case .forward = item, let source = sources[index], hboltIsAlbumableMedia(source) {
+                mediaIndices.append(index)
+            }
+        }
+        if mediaIndices.count < 2 {
+            return .single(messages)
+        }
+        var keyForIndex: [Int: Int64] = [:]
+        var g = 0
+        while g < mediaIndices.count {
+            let upper = min(g + 10, mediaIndices.count)
+            if upper - g >= 2 {
+                let key = Int64.random(in: Int64.min ... Int64.max)
+                for j in g ..< upper {
+                    keyForIndex[mediaIndices[j]] = key
+                }
+            }
+            g += 10
+        }
+        var signals: [Signal<EnqueueMessage, NoError>] = []
+        for (index, item) in messages.enumerated() {
+            if let key = keyForIndex[index], case let .forward(_, threadId, _, attributes, correlationId) = item, let source = sources[index] {
+                signals.append(hboltResend(account: account, message: source, threadId: threadId, grouping: .none, attributes: attributes, correlationId: correlationId, groupingKeys: [:], forcedGroupingKey: key))
+            } else {
+                signals.append(.single(item))
+            }
+        }
+        return combineLatest(signals)
+    }
 }
 
