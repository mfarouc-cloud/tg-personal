+/// Sends ONE chunk (<= 10 items) as a single album under the forced groupingKey, regardless of the
+/// source's own groupedId. Restricted (noforwards) items are re-uploaded as detached local bytes via
+/// the protected album pipeline; the rest reuse the server media object. Returns a Signal so chunks
+/// are sequenced (never all downloaded at once).
+private func hboltBulkSendChunk(account: Account, toPeerId: PeerId, toThreadId: Int64?, chunk: [Message], groupingKey: Int64?) -> Signal<Never, NoError> {
+    if chunk.isEmpty {
+        return .complete()
+    }
+    let protectedMessages = chunk.filter { HBOLTSettings.isProtected($0.id.peerId.toInt64()) }
+    let reusableMessages = chunk.filter { !HBOLTSettings.isProtected($0.id.peerId.toInt64()) }
+
+    var parts: [Signal<Never, NoError>] = []
+    if !reusableMessages.isEmpty {
+        var batch: [EnqueueMessage] = []
+        for message in reusableMessages {
+            if let enqueue = hboltBulkReuseMessage(message: message, toThreadId: toThreadId, groupingKey: groupingKey) {
+                batch.append(enqueue)
+            }
+        }
+        if !batch.isEmpty {
+            parts.append(enqueueMessages(account: account, peerId: toPeerId, messages: batch) |> ignoreValues)
+        }
+    }
+    if !protectedMessages.isEmpty {
+        parts.append(hboltBulkProtectedAlbumSignal(account: account, toPeerId: toPeerId, toThreadId: toThreadId, messages: protectedMessages, forcedGroupingKey: groupingKey))
+    }
+    var signal: Signal<Never, NoError> = .complete()
+    for part in parts {
+        signal = signal |> then(part)
+    }
+    return signal
+}
