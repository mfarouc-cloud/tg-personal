+/// HBOLT bulk entry: re-upload a chunk of protected messages as ONE intact album under a FORCED
+/// grouping key (the source's own groupedId is ignored). Downloads every item's bytes (cache-first,
+/// bounded) then enqueues the whole chunk together so it lands as a single album of up to 10. Returns
+/// a Signal so the caller can sequence chunks instead of downloading everything at once.
+func hboltBulkProtectedAlbumSignal(account: Account, toPeerId: PeerId, toThreadId: Int64?, messages: [Message], forcedGroupingKey: Int64?) -> Signal<Never, NoError> {
+    if messages.isEmpty {
+        return .complete()
+    }
+    let items = messages.map { HBOLTDeferredForward(message: $0, threadId: toThreadId, attributes: [], correlationId: nil, localGroupingKey: forcedGroupingKey) }
+    let readies = items.map { hboltMediaReadySignal(account: account, message: $0.message) }
+    return combineLatest(readies)
+    |> take(1)
+    |> mapToSignal { _ -> Signal<Never, NoError> in
+        var converted: [EnqueueMessage] = []
+        for item in items {
+            if let message = hboltConvertForward(account: account, message: item.message, threadId: item.threadId, attributes: item.attributes, correlationId: item.correlationId, localGroupingKey: item.localGroupingKey, viewOnce: false) {
+                converted.append(message)
+            }
+        }
+        if converted.isEmpty {
+            return .complete()
+        }
+        return enqueueMessages(account: account, peerId: toPeerId, messages: converted)
+        |> ignoreValues
+    }
+}
