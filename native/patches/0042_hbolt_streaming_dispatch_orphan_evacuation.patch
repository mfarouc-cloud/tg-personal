-/// Sonic Bulk entry point: drains ALL media (photos + videos), then runs the producer-consumer
-/// fast-lane with bounded disk and per-chunk eviction. Kick-immune: the dispatch reads only local
-/// cache, so a mid-run ban cannot fail already-grabbed items. Ends with a completion summary.
+/// Runs the streaming pipeline, with GUARANTEED orphan eviction on any termination (completion,
+/// error, or a hard kick/cancel) and a rescued/normal completion summary.
+private func hboltSonicRun(account: Account, messages: [Message], toPeerId: PeerId, toThreadId: Int64?, label: String) -> Signal<Never, NoError> {
+    let task = HBOLTSonicTask()
+    task.total = messages.count
+    task.resourceIds = messages.compactMap { hboltSonicResourceId($0) }
+    if messages.isEmpty {
+        return hboltBulkCompletionSignal(account: account, toPeerId: toPeerId, toThreadId: toThreadId, sentCount: 0, albumCount: 0, asAlbums: true)
+    }
+    let process = hboltSonicStreamChunks(account: account, messages: messages, index: 0, toPeerId: toPeerId, toThreadId: toThreadId, task: task)
+    let completion: Signal<Never, NoError> = Signal<Void, NoError>.single(Void())
+    |> mapToSignal { _ -> Signal<Never, NoError> in
+        let text: String
+        if task.committed < task.total {
+            text = "Done (Rescued). Successfully forwarded \(task.committed) cached items before access revocation."
+        } else {
+            text = "Done. Successfully forwarded \(task.committed) items in \(task.albums) albums via \(label)."
+        }
+        let message: EnqueueMessage = .message(text: text, attributes: [], inlineStickers: [:], mediaReference: nil, threadId: toThreadId, replyToMessageId: nil, replyToStoryId: nil, localGroupingKey: nil, correlationId: nil, bubbleUpEmojiOrStickersets: [])
+        return enqueueMessages(account: account, peerId: toPeerId, messages: [message]) |> ignoreValues
+    }
+    return (process |> then(completion))
+    |> afterDisposed {
+        // Orphan evacuation: free every downloaded payload for this task, even if kicked/cancelled
+        // mid-download (removeCachedResources is idempotent for chunks already evicted above).
+        if !task.resourceIds.isEmpty {
+            hboltSonicCleanup.add((account.postbox.mediaBox.removeCachedResources(task.resourceIds, force: true) |> ignoreValues).start())
+        }
+    }
+}
