         return process |> then(completion)
     }
 }
+
+// MARK: - Save Clean to Saved Messages: strip view-once/TTL and re-upload as permanent media.
+
+/// Pulls a view-once / self-destructing media from local cache (downloading if needed), strips ALL
+/// expiration (no AutoremoveTimeoutMessageAttribute, fresh detached media), and re-uploads it to the
+/// account's Saved Messages as a standard permanent item — never a .forward reference, which would
+/// render as "Expired". Emits true on dispatch, false if the media could not be read.
+public func hboltSaveCleanToSavedMessages(account: Account, message: Message) -> Signal<Bool, NoError> {
+    guard message.media.contains(where: { $0 is TelegramMediaImage || $0 is TelegramMediaFile }) else {
+        return .single(false)
+    }
+    return hboltBulkPrecache(account: account, message: message)
+    |> mapToSignal { _ -> Signal<Bool, NoError> in
+        guard let media = hboltBulkDetachCached(account: account, message: message) else {
+            return .single(false)
+        }
+        let attributes = message.attributes.filter { attr in
+            !(attr is AutoremoveTimeoutMessageAttribute)
+                && !(attr is SourceReferenceMessageAttribute)
+                && !(attr is ForwardCountMessageAttribute)
+                && !(attr is ReplyMessageAttribute)
+                && !(attr is ReplyMarkupMessageAttribute)
+                && !(attr is ViewCountMessageAttribute)
+                && !(attr is ForwardSourceInfoAttribute)
+        }
+        let enqueue: EnqueueMessage = .message(text: message.text, attributes: attributes, inlineStickers: [:], mediaReference: .standalone(media: media), threadId: nil, replyToMessageId: nil, replyToStoryId: nil, localGroupingKey: nil, correlationId: nil, bubbleUpEmojiOrStickersets: [])
+        return enqueueMessages(account: account, peerId: account.peerId, messages: [enqueue])
+        |> map { _ in true }
+    }
+}
