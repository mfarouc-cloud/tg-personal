+// Fast path: re-send the items by reference into Saved Messages, grouped as albums; anything the
+// server refuses even as a lone item is returned so the caller can re-upload it.
+private func hboltCleanSaveReferencePass(account: Account, messages: [Message]) -> Signal<[Message], NoError> {
+    let withMedia = messages.filter { message in
+        message.media.contains(where: { $0 is TelegramMediaImage || $0 is TelegramMediaFile })
+    }
+    if withMedia.isEmpty {
+        return .single([])
+    }
+    return hboltCleanSaveAlbumRecover(account: account, sources: withMedia, build: { message, groupId in
+        guard let media = message.media.first(where: { $0 is TelegramMediaImage || $0 is TelegramMediaFile }) else {
+            return nil
