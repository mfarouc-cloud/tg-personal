+// Fast path: NATIVE Telegram-to-Telegram forward into Saved Messages with drop-author (hideNames),
+// i.e. exactly what "Forward to Saved Messages (hide sender)" does — a server-side copy with no
+// download/upload, automatic file-reference revalidation, and original albums preserved (grouping
+// .auto). This is far more reliable than rebuilding messages by media id (stale file references).
+// Anything the server refuses even as a lone item (protected / view-once) is returned for re-upload.
+private func hboltCleanSaveReferencePass(account: Account, messages: [Message]) -> Signal<[Message], NoError> {
+    let withMedia = messages.filter { message in
+        message.media.contains(where: { $0 is TelegramMediaImage || $0 is TelegramMediaFile })
+    }
+    if withMedia.isEmpty {
+        return .single([])
+    }
+    return hboltCleanSaveAlbumRecover(account: account, sources: withMedia, build: { message, _ in
+        return .forward(source: message.id, threadId: nil, grouping: .auto, attributes: [ForwardOptionsMessageAttribute(hideNames: true, hideCaptions: false)], correlationId: nil)
+    })
 }
 
