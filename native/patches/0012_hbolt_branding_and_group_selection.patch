+    /// HBOLT: select every group the user is a member of (basic groups + supergroups).
+    func hboltSelectAllGroups() {
+        let _ = (self.context.engine.messages.chatList(group: .root, count: 5000)
+        |> take(1)
+        |> deliverOnMainQueue).startStandalone(next: { [weak self] chatList in
+            guard let self else {
+                return
+            }
+            var groups: [EnginePeer] = []
+            for item in chatList.items {
+                guard let peer = item.renderedPeer.peer else {
+                    continue
+                }
+                switch peer {
+                case .legacyGroup:
+                    groups.append(peer)
+                case let .channel(channel):
+                    if case .group = channel.info {
+                        groups.append(peer)
+                    }
+                default:
+                    break
+                }
+            }
+            if let limit = self.controller?.multipleSelectionLimit, groups.count > Int(limit) {
+                groups = Array(groups.prefix(Int(limit)))
+            }
+            let update: (ChatListNodeState) -> ChatListNodeState = { state in
+                var state = state
+                state.editing = true
+                for peer in groups {
+                    state.selectedPeerIds.insert(peer.id)
+                    state.selectedPeerMap[peer.id] = peer
+                }
+                return state
+            }
+            if let mainContainerNode = self.mainContainerNode {
+                mainContainerNode.currentItemNode.updateState(update)
+            } else if let chatListNode = self.chatListNode {
+                chatListNode.updateState(update)
+            }
+            self.textInputPanelNode?.updateSendButtonEnabled(!groups.isEmpty, animated: true)
+        })
+    }
