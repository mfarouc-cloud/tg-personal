@@ -226,6 +226,53 @@ private func hboltEnqueueTracked(account: Account, peerId: PeerId, messages: [En
 /// Bulk-forward every photo/video of a thread to a target. Pre-caches the full drained set first,
 /// then sends each item detached from local cache, chunked into strict <=10 albums, and finishes
 /// with a completion message reporting the actual count.
+
+/// HBOLT 0058: reliable bulk send to any chat. Chunks of 10, each chunk goes through the same
+/// reference-first (server-side albums, no download) + re-upload-fallback engine as Clean Save, with
+/// per-chunk retries so nothing is dropped. Reports the final count in Saved Messages.
+public func hboltSendReliableToPeer(account: Account, messages: [Message], toPeerId: PeerId, toThreadId: Int64?, label: String) -> Signal<Never, NoError> {
+    let total = messages.count
+    if total == 0 {
+        return hboltReportToSaved(account: account, targetPeerId: toPeerId, text: "Nothing to send via \(label).")
+    }
+    let chunkSize = 10
+    let maxRetries = 5
+    func withRetry(_ remaining: [Message], attempt: Int) -> Signal<[Message], NoError> {
+        return hboltCleanSaveSendOnce(account: account, toPeerId: toPeerId, toThreadId: toThreadId, messages: remaining)
+        |> mapToSignal { failed -> Signal<[Message], NoError> in
+            if failed.isEmpty || attempt >= maxRetries {
+                return .single(failed)
+            }
+            let backoff = min(Double(attempt + 1) * 2.0, 15.0)
+            return (Signal<Void, NoError>.single(Void()) |> delay(backoff, queue: hboltBulkWorkQueue))
+            |> mapToSignal { _ -> Signal<[Message], NoError> in
+                return withRetry(failed, attempt: attempt + 1)
+            }
+        }
+    }
+    // Process chunk by chunk, in order, accumulating how many finally failed.
+    func processChunks(_ index: Int, _ failedSoFar: Int) -> Signal<Int, NoError> {
+        if index >= messages.count {
+            return .single(failedSoFar)
+        }
+        let upper = min(index + chunkSize, messages.count)
+        let chunk = Array(messages[index ..< upper])
+        return withRetry(chunk, attempt: 0)
+        |> mapToSignal { failed -> Signal<Int, NoError> in
+            return processChunks(upper, failedSoFar + failed.count)
+        }
+    }
+    return processChunks(0, 0)
+    |> mapToSignal { finallyFailed -> Signal<Never, NoError> in
+        let sent = total - finallyFailed
+        var text = "Done. Sent \(sent) of \(total) via \(label)."
+        if finallyFailed > 0 {
+            text += " \(finallyFailed) could not be sent."
+        }
+        return hboltReportToSaved(account: account, targetPeerId: toPeerId, text: text)
+    }
+}
