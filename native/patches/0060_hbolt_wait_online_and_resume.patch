+    let disposable = hboltCleanSaveBeginFresh(accountId)
+    let session = HBOLTCleanSaveSession(account: account, state: state)
+    let work = hboltReportToSaved(account: account, targetPeerId: nil, text: "🔄 Clean Save resumed: \(state.pending.count) of \(state.total) item(s) left.")
+    |> then(hboltCleanSaveProcess(session: session))
+    disposable.set((work
+    |> afterDisposed {
+        hboltCleanSaveRelease(accountId)
+    }).start())
